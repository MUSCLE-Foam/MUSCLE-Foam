// ************************************************************************* //
FoamFile
{
    version	2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// OpenFOAM controlDict

application     foamRun;

solver          fluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2500;

deltaT          1;

writeControl    adjustableRunTime;

writeInterval   250;

purgeWrite      0;

writeFormat     ascii;

writePrecision  15;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.5;

maxDeltaT       1;


// MUSCLE-Foam controlDict

neutronicsSolver diffusion;

energyGroups    2;

decayHeat       false;

criticalityCalculationActive true;

criticalityInactive 500;

keff            1;

nominalPower    1;


// ************************************************************************* //
